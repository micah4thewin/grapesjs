      "tag": "main",
      "style": {
        "maxWidth": "space.measure",
        "gap": "space.7"
      },
      "children": ["hero", "services", "clients", "foot"]
    },
    "hero": {
      "id": "hero",
      "kind": "stack",
      "tag": "header",
      "style": {
        "pad": "space.8",
        "gap": "space.4"
      },
      "children": ["hero-h", "hero-b"]
    },
    "hero-h": {
      "id": "hero-h",
      "kind": "heading",
      "level": 1,
      "spans": [
        {
          "text": "Harbour & Vale"
        }
      ],
      "style": {
        "type": "type.h1",
        "fg": "color.fg"
      }
    },
    "hero-b": {
      "id": "hero-b",
      "kind": "text",
      "spans": [
        {
          "text": "A four-person studio that does research, then design, then leaves. We do not do retainers."
        }
      ],
      "style": {
        "type": "type.lead",
        "fg": "color.muted"
      }
    },
    "services": {
      "id": "services",
      "kind": "grid",
      "cols": 12,
      "style": {
        "gap": "space.5",
        "pad": "space.6"
      },
      "children": ["sv1", "sv2", "sv3"]
    },
    "clients": {
      "id": "clients",
      "kind": "stack",
      "style": {
        "pad": "space.6",
        "gap": "space.3",
        "bg": "color.surface"
      },
      "children": ["cl-h", "cl-b"]
    },
    "cl-h": {
      "id": "cl-h",
      "kind": "heading",
      "level": 2,
      "spans": [
        {
          "text": "Recent work"
        }
      ],
      "style": {
        "type": "type.h2",
        "fg": "color.fg"
      }
    },
    "cl-b": {
      "id": "cl-b",
      "kind": "text",
      "spans": [
        {
          "text": "A regional bank's mortgage journey, a hospital's rota tool, and a bakery's ordering page. In that order of difficulty, though not the order you would guess."
        }
      ],
      "style": {
        "type": "type.body",
        "fg": "color.muted"
      }
    },
    "foot": {
      "id": "foot",
      "kind": "stack",
      "tag": "footer",
      "style": {
        "pad": "space.6",
        "gap": "space.2"
      },
      "children": ["foot-h", "foot-b"]
    },
    "foot-h": {
      "id": "foot-h",
      "kind": "heading",
      "level": 2,
      "spans": [
        {
          "text": "Six-week engagements, quoted flat"
        }
      ],
      "style": {
        "type": "type.h3",
        "fg": "color.fg"
      }
    },
    "foot-b": {
      "id": "foot-b",
      "kind": "text",
      "spans": [
        {
          "text": "Start a conversation",
          "href": "/work"
        }
      ],
      "style": {
        "type": "type.body",
        "fg": "color.accent"
      }
