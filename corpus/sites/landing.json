{
  "schema": "lattice/1.0",
  "id": "landing",
  "name": "Northgate Landing",
  "icon": "assets/icon-landing.png",
  "tokens": {
    "color": {
      "bg": {
        "value": "#ffffff"
      },
      "surface": {
        "value": "#f4f5f7"
      },
      "fg": {
        "value": "#16181d"
      },
      "muted": {
        "value": "#585c66"
      },
      "accent": {
        "value": "#1d4ed8"
      },
      "on-accent": {
        "value": "#ffffff",
        "onLight": false
      }
    },
    "space": {
      "1": {
        "px": 4
      },
      "2": {
        "px": 8
      },
      "3": {
        "px": 12
      },
      "4": {
        "px": 16
      },
      "5": {
        "px": 24
      },
      "6": {
        "px": 32
      },
      "7": {
        "px": 48
      },
      "8": {
        "px": 64
      },
      "measure": {
        "px": 960
      }
    },
    "type": {
      "body": {
        "sizePx": 16,
        "lineHeight": 1.6,
        "weight": 400
      },
      "lead": {
        "sizePx": 20,
        "lineHeight": 1.5,
        "weight": 400
      },
      "h1": {
        "sizePx": 44,
        "lineHeight": 1.1,
        "weight": 700
      },
      "h2": {
        "sizePx": 30,
        "lineHeight": 1.2,
        "weight": 600
      },
      "h3": {
        "sizePx": 20,
        "lineHeight": 1.3,
        "weight": 600
      },
      "small": {
        "sizePx": 14,
        "lineHeight": 1.5,
        "weight": 400
      }
    },
    "radius": {
      "sm": {
        "px": 4
      },
      "md": {
        "px": 8
      },
      "lg": {
        "px": 16
      }
    }
  },
  "routes": [
    {
      "path": "/",
      "title": "Northgate — field service software",
      "description": "Scheduling, invoicing and dispatch for small field-service teams.",
      "root": "home"
    },
    {
      "path": "/pricing",
      "title": "Pricing — Northgate",
      "description": "Three plans, no per-seat surprises.",
      "root": "pricing"
    }
  ],
  "nodes": {
    "home": {
      "id": "home",
      "kind": "section",
      "tag": "main",
      "children": ["hero", "features", "cta"],
      "style": {
        "maxWidth": "space.measure"
      }
    },
    "hero": {
      "id": "hero",
      "kind": "stack",
      "tag": "header",
      "style": {
        "bg": "color.surface",
        "pad": "space.8",
        "gap": "space.4",
        "align": "center"
      },
      "children": ["hero-title", "hero-sub", "hero-shot"]
    },
    "hero-title": {
      "id": "hero-title",
      "kind": "heading",
      "level": 1,
      "style": {
        "type": "type.h1",
        "fg": "color.fg"
      },
      "spans": [
        {
          "text": "Dispatch that fits in a lunch break"
        }
      ]
    },
    "hero-sub": {
      "id": "hero-sub",
      "kind": "text",
      "style": {
        "type": "type.lead",
        "fg": "color.muted"
      },
      "spans": [
        {
          "text": "Northgate schedules crews, sends invoices and chases payment — "
        },
        {
          "text": "without a spreadsheet",
          "mark": "strong"
        },
        {
          "text": "."
        }
      ]
    },
    "hero-shot": {
      "id": "hero-shot",
      "kind": "image",
      "src": "assets/dispatch-board.png",
      "alt": "The Northgate dispatch board showing four crews assigned across a week",
      "width": 1200,
      "height": 720,
      "style": {
        "radius": "radius.lg"
      }
    },
    "features": {
      "id": "features",
      "kind": "grid",
      "cols": 12,
      "style": {
        "pad": "space.7",
        "gap": "space.5"
      },
      "children": ["f-sched", "f-invoice", "f-mobile"]
    },
    "f-sched": {
      "id": "f-sched",
      "kind": "stack",
      "place": {
        "col": 1,
        "span": 4
      },
      "style": {
        "gap": "space.2"
      },
      "children": ["f-sched-h", "f-sched-b"]
    },
    "f-sched-h": {
      "id": "f-sched-h",
      "kind": "heading",
      "level": 2,
      "style": {
        "type": "type.h3",
        "fg": "color.fg"
      },
      "spans": [
        {
          "text": "Scheduling"
        }
      ]
    },
    "f-sched-b": {
      "id": "f-sched-b",
      "kind": "text",
      "style": {
        "type": "type.body",
        "fg": "color.muted"
      },
      "spans": [
        {
          "text": "Drag a job onto a crew. Conflicts surface before the truck leaves."
        }
      ]
    },
    "f-invoice": {
      "id": "f-invoice",
      "kind": "stack",
      "place": {
        "col": 5,
        "span": 4
      },
      "style": {
        "gap": "space.2"
      },
      "children": ["f-invoice-h", "f-invoice-b"]
    },
    "f-invoice-h": {
      "id": "f-invoice-h",
      "kind": "heading",
      "level": 2,
      "style": {
        "type": "type.h3",
        "fg": "color.fg"
      },
      "spans": [
        {
          "text": "Invoicing"
        }
      ]
    },
    "f-invoice-b": {
      "id": "f-invoice-b",
      "kind": "text",
      "style": {
        "type": "type.body",
        "fg": "color.muted"
      },
      "spans": [
        {
          "text": "Invoice from the job record; the line items are already there."
        }
      ]
    },
    "f-mobile": {
      "id": "f-mobile",
      "kind": "stack",
      "place": {
        "col": 9,
        "span": 4
      },
      "style": {
        "gap": "space.2"
      },
      "children": ["f-mobile-h", "f-mobile-b"]
    },
    "f-mobile-h": {
      "id": "f-mobile-h",
      "kind": "heading",
      "level": 2,
      "style": {
        "type": "type.h3",
        "fg": "color.fg"
      },
      "spans": [
        {
          "text": "Works on the van"
        }
      ]
    },
    "f-mobile-b": {
      "id": "f-mobile-b",
      "kind": "text",
      "style": {
        "type": "type.body",
        "fg": "color.muted"
      },
      "spans": [
        {
          "text": "One page, no app store, works on a phone with two bars."
        }
      ]
    },
    "cta": {
      "id": "cta",
      "kind": "stack",
      "tag": "footer",
      "style": {
        "bg": "color.accent",
        "fg": "color.on-accent",
        "pad": "space.7",
        "gap": "space.3",
        "align": "center"
      },
      "children": ["cta-h", "cta-link"]
    },
    "cta-h": {
      "id": "cta-h",
      "kind": "heading",
      "level": 2,
      "style": {
        "type": "type.h2",
        "fg": "color.on-accent"
      },
      "spans": [
        {
          "text": "Two weeks free. No card."
        }
      ]
    },
    "cta-link": {
      "id": "cta-link",
      "kind": "text",
      "style": {
        "type": "type.body",
        "fg": "color.on-accent"
      },
      "spans": [
        {
          "text": "See the plans",
          "href": "/pricing"
        }
      ]
    },
    "pricing": {
      "id": "pricing",
      "kind": "section",
      "tag": "main",
      "style": {
        "pad": "space.7",
        "gap": "space.5",
        "maxWidth": "space.measure"
      },
      "children": ["pricing-h", "plans"]
    },
    "pricing-h": {
      "id": "pricing-h",
      "kind": "heading",
      "level": 1,
      "style": {
        "type": "type.h1",
        "fg": "color.fg"
      },
      "spans": [
        {
          "text": "Pricing"
        }
      ]
    },
    "plans": {
      "id": "plans",
      "kind": "grid",
      "cols": 12,
      "style": {
        "gap": "space.5"
      },
      "children": ["plan-solo", "plan-crew", "plan-fleet"]
    },
    "plan-solo": {
      "id": "plan-solo",
      "kind": "stack",
      "place": {
        "col": 1,
        "span": 4
      },
      "style": {
        "bg": "color.surface",
        "pad": "space.5",
        "gap": "space.2",
        "radius": "radius.md"
      },
      "children": ["plan-solo-h", "plan-solo-b"]
    },
    "plan-solo-h": {
      "id": "plan-solo-h",
      "kind": "heading",
      "level": 2,
      "style": {
        "type": "type.h3",
        "fg": "color.fg"
      },
      "spans": [
        {
          "text": "Solo — $29"
        }
      ]
    },
    "plan-solo-b": {
      "id": "plan-solo-b",
      "kind": "text",
      "style": {
        "type": "type.body",
        "fg": "color.muted"
      },
      "spans": [
        {
          "text": "One dispatcher, unlimited jobs."
        }
      ]
    },
    "plan-crew": {
      "id": "plan-crew",
      "kind": "stack",
      "place": {
        "col": 5,
        "span": 4
      },
      "style": {
        "bg": "color.surface",
        "pad": "space.5",
        "gap": "space.2",
        "radius": "radius.md"
      },
      "children": ["plan-crew-h", "plan-crew-b"]
    },
    "plan-crew-h": {
      "id": "plan-crew-h",
      "kind": "heading",
      "level": 2,
      "style": {
        "type": "type.h3",
        "fg": "color.fg"
      },
      "spans": [
        {
          "text": "Crew — $79"
        }
      ]
    },
    "plan-crew-b": {
      "id": "plan-crew-b",
      "kind": "text",
      "style": {
        "type": "type.body",
        "fg": "color.muted"
      },
      "spans": [
        {
          "text": "Up to eight techs, shared calendar."
        }
      ]
    },
    "plan-fleet": {
      "id": "plan-fleet",
      "kind": "stack",
      "place": {
        "col": 9,
        "span": 4
      },
      "style": {
        "bg": "color.surface",
        "pad": "space.5",
        "gap": "space.2",
        "radius": "radius.md"
      },
      "children": ["plan-fleet-h", "plan-fleet-b"]
    },
    "plan-fleet-h": {
      "id": "plan-fleet-h",
      "kind": "heading",
      "level": 2,
      "style": {
        "type": "type.h3",
        "fg": "color.fg"
      },
      "spans": [
        {
          "text": "Fleet — $199"
        }
      ]
    },
    "plan-fleet-b": {
      "id": "plan-fleet-b",
      "kind": "text",
      "style": {
        "type": "type.body",
        "fg": "color.muted"
      },
      "spans": [
        {
          "text": "Every crew, routing, and the API."
        }
      ]
    }
  }
}
