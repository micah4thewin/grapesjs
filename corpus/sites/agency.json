    "w-b": {
      "id": "w-b",
      "kind": "text",
      "spans": [
        {
          "text": "Two weeks of research, three of design, one of handover. You get the files, the reasoning, and a recording of every session."
        }
      ],
      "style": {
        "type": "type.body",
        "fg": "color.muted"
      }
    },
    "w-img": {
      "id": "w-img",
      "kind": "image",
