        "type": "type.h3",
        "fg": "color.fg"
      }
    },
    "sv1-b": {
      "id": "sv1-b",
      "kind": "text",
      "spans": [
        {
          "text": "Six to ten interviews, transcribed, with the awkward parts left in."
        }
      ],
      "style": {
        "type": "type.body",
        "fg": "color.muted"
      }
    },
    "sv2": {
      "id": "sv2",
      "kind": "stack",
      "place": {
        "col": 5,
        "span": 4
      },
      "style": {
        "gap": "space.2"
      },
      "children": ["sv2-h", "sv2-b"]
    },
    "sv2-h": {
      "id": "sv2-h",
      "kind": "heading",
      "level": 2,
      "spans": [
        {
          "text": "Design"
        }
      ],
      "style": {
        "type": "type.h3",
        "fg": "color.fg"
      }
    },
    "sv2-b": {
      "id": "sv2-b",
      "kind": "text",
      "spans": [
        {
          "text": "Flows and screens, in the browser, tested with the people from step one."
        }
